# Shell scripts must always use LF — a CRLF shebang (#!/bin/bash\r) makes
# Linux/WSL report "required file not found" because it looks for an
# interpreter literally named "bash\r".
*.sh    text eol=lf

# .env files get `. .env.prod` sourced by run-prod-stack.sh — a CRLF line
# ending makes bash choke with "$'\r': command not found".
.env*   text eol=lf
