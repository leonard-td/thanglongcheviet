auto-install-peers=true

# Reduce npm registry rate-limit (E429) risk
prefer-offline=true
maxsockets=5
fetch-retries=5
fetch-retry-factor=2
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=120000
fetch-timeout=600000

# Speed + less noisy CI/dev
audit=false
fund=false
update-notifier=false
progress=false

# npm v10 peer-deps in Medusa can be strict; keep installs moving
legacy-peer-deps=true
