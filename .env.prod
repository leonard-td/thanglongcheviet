# =============================================================================
# docker-compose environment. Copy to .env and adjust as needed:
#   cp .env.example .env
# (This is for docker-compose only; the native run-dev scripts use apps/backend/.env)
# =============================================================================

HTTP_PORT=8800
DOMAIN=localhost

# --- Default admin user (created on first backend boot) ---------------------
ADMIN_EMAIL=admin@medusa.local
ADMIN_PASSWORD=supersecret123

# --- Postgres ---------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=medusa
POSTGRES_PORT=5432

# --- Redis ------------------------------------------------------------------
REDIS_PORT=6379

# --- Medusa backend secrets / CORS ------------------------------------------
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret
# Regex matching any http(s) origin (Medusa's cors config treats a
# /.../-wrapped string as a RegExp) — lets any domain you point at this
# server call the API without listing each one here. Narrow this to an
# explicit comma-separated origin list only if you need to restrict which
# sites may call the API directly (nginx already makes the browser traffic
# same-origin regardless).
STORE_CORS=/.*/
ADMIN_CORS=/.*/
AUTH_CORS=/.*/
# Public origin for uploaded-file URLs (file provider appends /static). Only
# matters for the transient absolute URL returned right after an upload —
# every URL this project persists is normalized to a relative /static/...
# path, and nginx proxies /static/ the same way regardless of domain, so
# localhost is a fine default here.
MEDUSA_BACKEND_URL=http://localhost:${HTTP_PORT}
# LOCAL/HTTP ONLY: allows the admin session cookie over plain http (the prod
# stack runs NODE_ENV=production, which otherwise forces a Secure/HTTPS cookie).
# Remove/leave unset on a real HTTPS deployment.
COOKIE_SECURE=false

# --- apps/web (Nuxt) Store API access ----------------------------------------
# Passed through to the `web` service by infra/docker-compose.prod.yml.
# These belong to the PROD database. After first deploy, provision both with:
#   ENV_FILE=.env.prod node scripts/setup-web-integration.mjs
# Browser-side Medusa URL for apps/web — NUXT_ prefix (Nuxt runtime config),
# NOT NEXT_ (that prefix belongs to the Next.js storefront below). Left EMPTY
# on purpose: the browser then calls the SAME origin the page was loaded
# from (nginx proxies /store there already), which works for whichever
# domain the visitor used instead of one hardcoded host.
NUXT_PUBLIC_MEDUSA_BACKEND_URL=
NUXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_bf8663424425db64f20f1fa29e6e66ae5c6eee8446c1c8129b7950c1b66bafba
NUXT_PUBLIC_MEDUSA_REGION_ID=reg_01KYAHME9RKZ4JB8FZYPM9S1YH

# --- Storefront -------------------------------------------------------------
# Host port for the storefront. Change to e.g. 8001 if 8000 is taken by another
# project (the main project's nginx uses 8000).
STOREFRONT_PORT=8000

# REQUIRED before starting the storefront profile. Get it from the admin:
#   http://${DOMAIN}:${HTTP_PORT}/app  ->  Settings  ->  Publishable API keys
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_4b846b787e9885af621045e30f7a0f0d150b275cd08a523605cb5687c0740d7c

NEXT_PUBLIC_DEFAULT_REGION=dk
# Optional Stripe publishable key
NEXT_PUBLIC_STRIPE_KEY=

# --- nginx single entrypoint -------------------------------------------------
# Must differ from STOREFRONT_PORT above (both default-collide on 8000
# otherwise). Use 80 once you've confirmed nothing else on the host needs it.

# rebuild all images and clear volumes/networks before starting the prod stack
# WARNING: true WIPES THE PROD DATABASE (every volume, Postgres included) on
# the next ./start.prod.sh run. Base data is re-seeded automatically, but real
# content (products, orders, uploaded media) is GONE — set this back to false
# right after the one-off rebuild that needed it.
REBUILD_ALL=false
