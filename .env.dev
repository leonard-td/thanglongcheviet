# =============================================================================
# docker-compose environment. Copy to .env and adjust as needed:
#   cp .env.example .env
# (This is for docker-compose only; the native run-dev scripts use apps/backend/.env)
# =============================================================================

HTTP_PORT=8800
DOMAIN=localhost

# --- Default admin user (created on first backend boot) ---------------------
ADMIN_EMAIL=admin@medusa.local
ADMIN_PASSWORD=supersecret123

# --- Postgres ---------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=medusa
POSTGRES_PORT=5432

# --- Redis ------------------------------------------------------------------
REDIS_PORT=6379

# --- Medusa backend secrets / CORS ------------------------------------------
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret
# Origins must include the nginx entrypoint you actually browse (localhost:8800),
# not just the direct backend/dev ports.
STORE_CORS=http://localhost:3000,http://${DOMAIN}:${HTTP_PORT}
ADMIN_CORS=http://localhost:9000,http://${DOMAIN}:${HTTP_PORT}
AUTH_CORS=http://localhost:9000,http://localhost:3000,http://${DOMAIN}:${HTTP_PORT}
# LOCAL/HTTP ONLY: allows the admin session cookie over plain http (the prod
# stack runs NODE_ENV=production, which otherwise forces a Secure/HTTPS cookie).
# Remove/leave unset on a real HTTPS deployment.
COOKIE_SECURE=false

# --- apps/web (Nuxt) Store API access ----------------------------------------
# Passed through to the `web` service by infra/docker-compose.yml. Provision
# both values automatically with: node scripts/setup-web-integration.mjs
NUXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_0fd8fd9626a9029c815d2775569da462e5072597e7f4f0a7bdb51c6ea70eae49
NUXT_PUBLIC_MEDUSA_REGION_ID=reg_01KX7MNGQDC034CTQGSBRQY6CP

# --- Storefront -------------------------------------------------------------
# Host port for the storefront. Change to e.g. 8001 if 8000 is taken by another
# project (the main project's nginx uses 8000).
STOREFRONT_PORT=8000

# REQUIRED before starting the storefront profile. Get it from the admin:
#   http://${DOMAIN}:${HTTP_PORT}/app  ->  Settings  ->  Publishable API keys
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_4ea17df3249f044e982c3b171f9b5533cb3aea79d1d6bd65b2e64604e5d506fd

NEXT_PUBLIC_DEFAULT_REGION=vn
# Optional Stripe publishable key
NEXT_PUBLIC_STRIPE_KEY=

# --- nginx single entrypoint -------------------------------------------------
# Must differ from STOREFRONT_PORT above (both default-collide on 8000
# otherwise). Use 80 once you've confirmed nothing else on the host needs it.
NUXT_PUBLIC_MEDUSA_NAVIGATION_ID=01KX7N5861SYHXZ0AMJAAYWRE1
