    "@swc/core": "^1.7.28",
    "@swc/jest": "^0.2.36",
    "@types/archiver": "^6.0.3",
    "@types/jest": "^29.5.13",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.12.11",
    "@types/pg": "^8.15.4",
    "@types/pg-copy-streams": "^1.2.5",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.2.25",
    "@types/unzipper": "^0.10.11",
    "eslint": "^9.39.4",
    "jest": "^29.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2",
    "vite": "^5.4.14"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@10.9.3"
