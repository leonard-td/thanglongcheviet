# =============================================================================
# docker-compose environment. Copy to .env.dev (or .env.prod) and adjust:
#   cp .env.example .env.dev
# Native (non-docker) Medusa runs still use apps/backend/.env separately.
# =============================================================================

HTTP_PORT=8800
DOMAIN=localhost

# --- Default admin user (created on first backend boot) ---------------------
ADMIN_EMAIL=admin@medusa.local
ADMIN_PASSWORD=supersecret123

# --- Postgres ---------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=medusa
POSTGRES_PORT=5432

# --- Medusa backend secrets / CORS ------------------------------------------
# IMPORTANT: change JWT_SECRET and COOKIE_SECRET before any public deploy.
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret
# Origins must include the nginx entrypoint you actually browse (localhost:8800),
# not just the direct backend/dev ports.
STORE_CORS=http://localhost:8800,http://${DOMAIN}:${HTTP_PORT}
ADMIN_CORS=http://localhost:8800,http://localhost:9000,http://${DOMAIN}:${HTTP_PORT}
AUTH_CORS=http://localhost:8800,http://localhost:9000,http://localhost:3000,http://${DOMAIN}:${HTTP_PORT}
# LOCAL/HTTP ONLY: allows the admin session cookie over plain http (the prod
# stack runs NODE_ENV=production, which otherwise forces a Secure/HTTPS cookie).
# Leave unset / set true on a real HTTPS deployment.
COOKIE_SECURE=false
# Nuxt cart/auth cookies follow the same flag via NUXT_PUBLIC_COOKIE_SECURE
# (also accepts COOKIE_SECURE=true). Keep false for http://localhost:8800.
NUXT_PUBLIC_COOKIE_SECURE=false

# --- apps/web (Nuxt) Store API access ----------------------------------------
# REQUIRED for the customer-facing site's product/cart/checkout features.
# Passed through to the `web` service by both compose files. Provision
# automatically (creates VN region, shipping, prices, then fills these in):
#   node scripts/setup-web-integration.mjs
NUXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=
NUXT_PUBLIC_MEDUSA_REGION_ID=
NUXT_PUBLIC_MEDUSA_NAVIGATION_ID=
NUXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:8800

# --- Storefront (optional Medusa Next.js profile — not used by Nuxt web) ----
STOREFRONT_PORT=8000
# Get from admin: http://${DOMAIN}:${HTTP_PORT}/app -> Settings -> Publishable API keys
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_your_publishable_key_here
NEXT_PUBLIC_DEFAULT_REGION=vn
NEXT_PUBLIC_STRIPE_KEY=

# --- nginx / admin HMR ------------------------------------------------------
# Admin hot-reload in Docker (default off — set false + ENABLE_ADMIN_HMR=true to enable)
DISABLE_ADMIN_HMR=true
# ENABLE_ADMIN_HMR=true
# ADMIN_FORCE_REBUILD=true
VITE_HMR_CLIENT_PORT=9000
