# =============================================================================
# docker-compose environment template.
#   New production deployment: cp .env.example .env.prod
#   (Local dev already has a ready-made .env.dev — no need to copy this.)
# (This is for docker-compose only; the native run-dev scripts use apps/backend/.env)
#
# DOMAIN is now purely informational (used in a couple of echoed login-URL
# messages and by deploy.sh's convenience auto-rewrite) — CORS, the backend
# URL, and the storefront's Store API URL below no longer derive from it, so
# any number of domains can point at the same server without editing this
# file per-domain.
# =============================================================================

HTTP_PORT=8800
DOMAIN=localhost

# --- Default admin user (created on first backend boot) ---------------------
ADMIN_EMAIL=admin@medusa.local
ADMIN_PASSWORD=supersecret123

# --- Postgres ---------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=medusa
POSTGRES_PORT=5432

# --- Redis ------------------------------------------------------------------
REDIS_PORT=6379

# --- Medusa backend secrets / CORS ------------------------------------------
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret
# Regex matching any http(s) origin (Medusa's cors config treats a
# /.../-wrapped string as a RegExp) — lets any domain you point at this
# server call the API without listing each one here. Narrow this to an
# explicit comma-separated origin list only if you need to restrict which
# sites may call the API directly (nginx already makes the browser traffic
# same-origin regardless).
STORE_CORS=/.*/
ADMIN_CORS=/.*/
AUTH_CORS=/.*/
# Public origin for uploaded-file URLs (file provider appends /static). Only
# matters for the transient absolute URL returned right after an upload —
# every URL this project persists is normalized to a relative /static/...
# path, and nginx proxies /static/ the same way regardless of domain, so
# localhost is a fine default here.
MEDUSA_BACKEND_URL=http://localhost:${HTTP_PORT}
# LOCAL/HTTP ONLY: allows the admin session cookie over plain http (the prod
# stack runs NODE_ENV=production, which otherwise forces a Secure/HTTPS cookie).
# Remove/leave unset on a real HTTPS deployment.
COOKIE_SECURE=false

# --- apps/web (Nuxt) Store API access ----------------------------------------
# Passed through to the `web` service by infra/docker-compose*.yml. After
# first deploy, provision both with:
#   ENV_FILE=.env.prod node scripts/setup-web-integration.mjs
# Browser-side Medusa URL for apps/web — NUXT_ prefix (Nuxt runtime config),
# NOT NEXT_ (that prefix belongs to the Next.js storefront below). Left EMPTY
# on purpose: the browser then calls the SAME origin the page was loaded
# from (nginx proxies /store there already), which works for whichever
# domain the visitor used instead of one hardcoded host.
NUXT_PUBLIC_MEDUSA_BACKEND_URL=
NUXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=
NUXT_PUBLIC_MEDUSA_REGION_ID=
# Navigation menu id (medusa-navigation-menu). Run: npm run seed:navigation -w @dtc/backend
NUXT_PUBLIC_MEDUSA_NAVIGATION_ID=

# --- Storefront (optional, standalone Next.js — not routed via nginx) -------
# Host port for the storefront profile. Change to e.g. 8001 if 8000 is taken
# by another project (the main project's nginx uses 8000).
STOREFRONT_PORT=8000

# REQUIRED before starting the storefront profile. Get it from the admin:
#   http://${DOMAIN}:${HTTP_PORT}/app  ->  Settings  ->  Publishable API keys
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=
NEXT_PUBLIC_DEFAULT_REGION=vn
# Optional Stripe publishable key
NEXT_PUBLIC_STRIPE_KEY=

# --- Admin hot-reload in Docker (dev only; harmless left off in prod) -------
DISABLE_ADMIN_HMR=true
# ENABLE_ADMIN_HMR=true
# ADMIN_FORCE_REBUILD=true
VITE_HMR_CLIENT_PORT=9000

# --- Telegram care-channel ---------------------------------------------------
# Credentials are stored in DB after seeding (Admin → Kênh CSKH). Do not commit real tokens.
# Seed: TELEGRAM_SEED_SEND_TEST=1 npm run seed:care-channel-telegram -w @dtc/backend
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_CHANNEL_NAME=Telegram CSKH
TELEGRAM_SEED_SEND_TEST=

# --- nginx single entrypoint -------------------------------------------------
# Must differ from STOREFRONT_PORT above (both default-collide on 8000
# otherwise). Use 80 once you've confirmed nothing else on the host needs it.

# --- Restic DB Backup --------------------------------------------------------
# Repository: local path (/backups), S3 (s3:s3.amazonaws.com/bucket), or SFTP (sftp:user@host:/path)
RESTIC_REPOSITORY=/backups
# Encryption password — CHANGE THIS in production!
RESTIC_PASSWORD=change-me-restic-password
# S3 credentials (only if RESTIC_REPOSITORY starts with s3:)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Cron schedule (default: 2:00 AM daily, Asia/Ho_Chi_Minh timezone)
BACKUP_CRON=0 2 * * *
# Retention policy
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=6

# rebuild all images and clear volumes/networks before starting the prod stack
# WARNING: true WIPES THE PROD DATABASE (every volume, Postgres included) on
# the next ./start.prod.sh run. Base data is re-seeded automatically, but real
# content (products, orders, uploaded media) is GONE — set this back to false
# right after the one-off rebuild that needed it.
REBUILD_ALL=false

# --- Ask Messages (Medusa /store/ask) ---------------------------------------
# Server-only. Never put COHERE_API_KEY in NUXT_PUBLIC_*.
ASK_NLU_PROVIDER=rule
COHERE_API_KEY=
# Production recommendation: set COHERE_RERANK=1 + a real COHERE_API_KEY for
# better product ranking after keyword recall (fail-soft if Cohere is down).
# Dev default stays 0 to avoid unexpected API cost.
COHERE_RERANK=0
