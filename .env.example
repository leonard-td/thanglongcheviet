NEXT_PUBLIC_DEFAULT_REGION=dk
# Optional Stripe publishable key
NEXT_PUBLIC_STRIPE_KEY=

# --- Nuxt web (Medusa commerce — products/cart) -----------------------------
NUXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
NUXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_your_publishable_key_here
NUXT_PUBLIC_MEDUSA_REGION_ID=
NUXT_PUBLIC_MEDUSA_NAVIGATION_ID=

# --- nginx single entrypoint -------------------------------------------------
# Must differ from STOREFRONT_PORT above (both default-collide on 8000
# otherwise). Use 80 once you've confirmed nothing else on the host needs it.
HTTP_PORT=8080
# Admin hot-reload in Docker (default off — set false + ENABLE_ADMIN_HMR=true to enable)
DISABLE_ADMIN_HMR=true
# ENABLE_ADMIN_HMR=true
# ADMIN_FORCE_REBUILD=true
VITE_HMR_CLIENT_PORT=9000

# --- Telegram care-channel ---------------------------------------------------
# Credentials are stored in DB after seeding (Admin → Kênh CSKH). Do not commit real tokens.
# Seed: TELEGRAM_SEED_SEND_TEST=1 npm run seed:care-channel-telegram -w @dtc/backend
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_CHANNEL_NAME=Telegram CSKH
TELEGRAM_SEED_SEND_TEST=
